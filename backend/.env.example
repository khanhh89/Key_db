# =============================================
# Sao chép file này thành .env và điền giá trị
# cp .env.example .env
# =============================================

# Server
PORT=8080

# Database - PostgreSQL
# Nếu chạy Local:
# DB_URL=jdbc:postgresql://localhost:5432/modlienquan
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# Nếu dùng Supabase (KHUYẾN NGHỊ: Dùng Connection Pooler - Chế độ Session Mode để hỗ trợ IPv4 trên Render/Cloud):
# DB_URL=jdbc:postgresql://aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.[your-project-ref]
# DB_PASSWORD=your-supabase-db-password

# Hoặc dùng Supabase Direct Connection (Chỉ hoạt động nếu môi trường hỗ trợ IPv6):
# DB_URL=jdbc:postgresql://db.[your-project-ref].supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=your-supabase-db-password

# Mail (nếu dùng tính năng gửi email)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
